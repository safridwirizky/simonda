DEBUG=1
SECRET_KEY=ganti-dengan-hasil-perintah-di-samping # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Basis data: SQLite dipakai secara default (dev maupun produksi/PythonAnywhere)
# begitu blok DB_* dan DATABASE_URL di bawah dibiarkan kosong -- tidak perlu
# server basis data terpisah. Isi blok DB_* kalau kamu memang mau pakai
# Postgres lokal sendiri.
# DB_NAME=simonda
# DB_USER=simonda
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Alternatif ke Postgres terkelola (mis. Neon) lewat satu connection string;
# mengalahkan blok DB_* di atas kalau diisi. Format:
# postgresql://user:pass@host/db?sslmode=require
# Biarkan baris ini ADA tapi KOSONG (jangan hapus/comment) -- settings.py
# sengaja memaksa nilai dari .env ini menang atas DATABASE_URL yang mungkin
# sudah ter-export di shell dari project lain di mesin yang sama.
DATABASE_URL=

# Isi kelima variabel R2 ini untuk memakai Cloudflare R2 sebagai penyimpanan
# berkas bukti dukung -- wajib di produksi kalau frontend (Cloudflare Pages)
# dan backend beda domain, supaya tautan berkas jadi URL utuh, bukan path
# relatif yang cuma benar kalau frontend-backend satu server.
# Kosongkan semua untuk tetap pakai folder lokal backend/media/ (dev).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# SSO dengan Esa Office (OpenID Connect, Authorization Code + PKCE). Kosongkan
# ESA_OFFICE_ISSUER untuk memakai login lokal saja. Semua alamat https dan tanpa
# "#". Daftarkan SANDO sebagai klien di Esa Office dengan redirect URI persis
# sama dengan ESA_OFFICE_REDIRECT_URI; client secret jangan pernah ke frontend.
# Cek hasilnya dari server: python manage.py esa_office_cek
# ESA_OFFICE_ISSUER=https://esa-office.rotendaokab.go.id
# ESA_OFFICE_CLIENT_ID=sando
# ESA_OFFICE_CLIENT_SECRET=
# ESA_OFFICE_REDIRECT_URI=https://<backend-sando>/api/auth/esa/callback
# ESA_OFFICE_FRONTEND_URL=https://<frontend-sando>
# Opsional (nilai bawaan di kanan):
# ESA_OFFICE_SCOPE=openid profile
# ESA_OFFICE_ALGORITMA=RS256,ES256
# ESA_OFFICE_TIMEOUT=8
# ESA_OFFICE_TAUTKAN_NIP=              # NIP verifikator/admin lama yang boleh ditautkan otomatis
# ESA_OFFICE_PETAKAN_OPD_OTOMATIS=1    # 0 = OPD hanya lewat esa_id yang diisi admin
# ESA_OFFICE_LOGIN_LOKAL=1             # 0 = sandi lokal hanya untuk administrator
