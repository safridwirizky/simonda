DEBUG=1
SECRET_KEY=ganti-dengan-hasil-perintah-di-bawah
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# python -c "import secrets; print(secrets.token_urlsafe(50))"

# Basis data: SQLite dipakai secara default (dev maupun produksi/PythonAnywhere)
# begitu blok DB_* dan DATABASE_URL di bawah dibiarkan kosong -- tidak perlu
# server basis data terpisah. Isi blok DB_* kalau kamu memang mau pakai
# Postgres lokal sendiri.
# DB_NAME=simonda
# DB_USER=simonda
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Alternatif ke Postgres terkelola (mis. Neon) lewat satu connection string;
# mengalahkan blok DB_* di atas kalau diisi. Format:
# postgresql://user:pass@host/db?sslmode=require
# Biarkan baris ini ADA tapi KOSONG (jangan hapus/comment) -- settings.py
# sengaja memaksa nilai dari .env ini menang atas DATABASE_URL yang mungkin
# sudah ter-export di shell dari project lain di mesin yang sama.
DATABASE_URL=

# Isi kelima variabel R2 ini untuk memakai Cloudflare R2 sebagai penyimpanan
# berkas bukti dukung -- wajib di produksi kalau frontend (Cloudflare Pages)
# dan backend beda domain, supaya tautan berkas jadi URL utuh, bukan path
# relatif yang cuma benar kalau frontend-backend satu server.
# Kosongkan semua untuk tetap pakai folder lokal backend/media/ (dev).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
